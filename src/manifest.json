{
  "manifest_version": 3,
  "name": "Offer Search",
  "version": "2.0.0",
  "description": "Récupère tes offres d'emploi (LinkedIn, Indeed)",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Offer Search"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.indeed.fr/*",
    "http://localhost:8000/*"
  ],
  "icons": {
    "128": "icons/icon-128.png"
  }
}